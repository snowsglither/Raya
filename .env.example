# RAYA V2 — Phase 1
# Aucune variable n'est requise pour démarrer le CLI (Model Layer = NullProvider
# stub, pas d'appel réseau). Valeurs par défaut raisonnables si non définies.

# RAYA_DATA_DIR=C:/chemin/vers/donnees/partagees
# RAYA_DB_PATH=C:/chemin/vers/raya_v2.sqlite3   # défaut : <RAYA_DATA_DIR>/raya_v2.sqlite3
# RAYA_TOOL_WORKSPACE_DIR=                        # défaut : <RAYA_DATA_DIR>/workspace (sandbox filesystem.*)
# RAYA_DEVICE_SCREENSHOT_DIR=                     # défaut : <RAYA_DATA_DIR>/screenshots
# RAYA_CONTEXT_BUDGET_TOKENS=4096
# RAYA_WORLD_STATE_TTL_S=                        # défaut : pas de péremption automatique
# RAYA_MEMORY_SEARCH_LIMIT=20
# RAYA_MAX_CONCURRENT_TASKS=2
# RAYA_MAX_TOOL_ITERATIONS=12                     # borne les tool calls par tour de conversation (jamais tasks.create, non borné par ce réglage)
# OLLAMA_API_KEY=                                 # utilisé à partir de la Phase 3
# RAYA_OLLAMA_HOST=https://ollama.com
# RAYA_ENABLE_OLLAMA_LOCAL=false                   # opt-in : nécessite un serveur Ollama local réellement lancé
# RAYA_OLLAMA_LOCAL_HOST=http://localhost:11434
# RAYA_MODEL_POOL=                                 # défaut : pool intégré raisonnable (voir raya/runtime/config.py::_DEFAULT_MODEL_POOL) — format "model_id:cap1|cap2,model_id2:cap3"
# RAYA_LOCAL_MODEL_POOL=                           # même format, pour le pool Ollama local (RAYA_ENABLE_OLLAMA_LOCAL)

# Device Agents (raya/devices/) — activés par défaut, se dégradent honnêtement
# (absents du DeviceRegistry, jamais un crash) si le matériel/logiciel requis
# n'est pas disponible sur cette machine.
# RAYA_ENABLE_WINDOWS_DEVICE=true
# RAYA_ENABLE_BROWSER_DEVICE=true
# RAYA_CDP_PORT=9223                               # port CDP dédié à l'automation (raya/devices/browser/session.py) — lu directement via os.environ au chargement du module : doit être une VRAIE variable d'environnement OS si tu le changes (pas seulement une ligne .env), sinon le défaut 9223 s'applique

# Chantier 12 §C / Phase 7 — Perception (capteurs légers, continus, jamais de LLM)
# RAYA_ENABLE_PERCEPTION=true
# RAYA_PERCEPTION_POLL_INTERVAL_S=3.0

# Phase 6 — Cockpit web (raya/runtime/entrypoints/web.py, `raya-web`)
# RAYA_WEB_HOST=127.0.0.1
# RAYA_WEB_PORT=8765
# RAYA_ENABLE_VOICE=false                          # opt-in : matériel audio + modèles Whisper/Kokoro réels

# Phase 9 — Interface Telegram (raya/interfaces/telegram/), démarrée par
# raya-web (RAYA_ENABLE_VOICE et RAYA_TELEGRAM_ENABLED sont indépendants,
# les deux peuvent tourner en même temps derrière le même Core).
# RAYA_TELEGRAM_ENABLED=false
# RAYA_TELEGRAM_BOT_TOKEN=                          # jamais committé — bot @RayaV2AssistantBot
# RAYA_TELEGRAM_ALLOWED_USER_IDS=                   # IDs Telegram numériques séparés par des virgules ; vide = personne n'est autorisé (fail closed)
# RAYA_TELEGRAM_POLL_TIMEOUT_S=25

# Chantier 12 — Temporal system (raya/contracts/clock.py, system.time.now)
# RAYA_TIMEZONE=Europe/Brussels                    # défaut déjà Europe/Brussels si non défini

# Chantier 13 — Phone Integration MVP (raya/devices/ios/, Microsoft Phone Link)
# RAYA_ENABLE_PHONE_DEVICE=true                     # défaut déjà true ; se dégrade honnêtement si Phone Link absent
